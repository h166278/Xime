+    // 方案把 page_size 当选重布局的一部分时（alternative_select_keys /
+    // select_comment_pattern），不覆盖——飞系增强一页正好 1 正选 + 5 数选，
+    // 大 page_size 会把第二页声笔字挤上第一页。拼音/五笔没有这两项，
+    // 继续用 app 设置覆盖 PC 遗留的 5。空白视为未配置。
+    bool schemaKeepsOwnPageSize(RimeConfig* config) {
+        const char* keys = rime->config_get_cstring(
