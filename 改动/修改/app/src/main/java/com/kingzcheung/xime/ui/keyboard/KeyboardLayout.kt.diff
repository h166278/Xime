+    val longPressBubbleLabels = if (longPressDisplay == "bubble") {
+        longPressConfig?.values?.map { it.label }?.filter { it.isNotEmpty() }?.ifEmpty { null }
+    } else null
+    val longPressBubbleMap = if (longPressDisplay == "bubble") {
+        longPressConfig?.values?.associateBy { it.label }
+    } else null
+
+    val onClick: () -> Unit = remember(
+        tapAction, tapValue, keyId,
+        onKeyPress, onGestureAction, overlayFace, onCommitText, onConsumeEnglishPunct,
+    ) {
+        {
+            if (overlayFace != null) {
+                onKeyPress("$LAYOUT46_OVERLAY_PREFIX$keyId")
+                onConsumeEnglishPunct?.invoke()
+            } else if (tapAction != null && tapAction != GestureAction.COMMIT) {
+                onGestureAction?.invoke(tapAction, tapValue)
